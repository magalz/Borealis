# Borealis-owned files are normalized to LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# apps/android is a git subtree of moonlight-android: keep upstream bytes
# exactly as upstream stores them, so syncs never show line-ending churn.
apps/android/** -text

# core/third_party holds vendored moonlight-common-c (with enet and nanors); some
# files keep CRLF line ends: store the bytes exactly as upstream does.
core/third_party/** -text

# Borealis-owned code inside the Android build is normalized again.
apps/android/borealis/** text=auto eol=lf
apps/android/build-logic/** text=auto eol=lf
apps/android/app/src/main/jni/borealis/** text=auto eol=lf

# The Kotlin of the :app module is Borealis code since ADR 0054 and Sprints 12 to 14 (the inherited
# Java is gone), so it is normalized to LF as well. The rest of apps/android/app keeps -text.
apps/android/app/src/**/*.kt text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.so binary
*.a binary

# Raw host responses are byte-exact captures (CRLF line ends, trailing bytes).
core/tests/fixtures/**/*.response binary

# HEVC SPS test fixtures (raw NAL units).
apps/android/borealis/host/src/test/resources/hevc/*.bin binary
