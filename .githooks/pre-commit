#!/bin/sh
# Borealis pre-commit hook. Not active by default; opt in with:
#   git config core.hooksPath .githooks
#
# - Kotlin/KTS under Borealis-owned Android paths: ./gradlew spotlessCheck (apps/android)
# - C/C++ under core/ or apps/android/app/src/main/jni/borealis/: clang-format --dry-run --Werror
# Inherited Moonlight files and the vendored core/third_party/ sources are never checked or reformatted.

repo_root=$(git rev-parse --show-toplevel) || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

kotlin_re='^apps/android/((borealis|build-logic)/|app/src/(main/kotlin|test|androidTest)/).*\.(kt|kts)$|^apps/android/.*\.gradle\.kts$'
cpp_re='^(core/|apps/android/app/src/main/jni/borealis/).*\.(c|cc|cpp|cxx|h|hh|hpp)$'

if printf '%s\n' "$staged" | grep -Eq "$kotlin_re"; then
    echo "pre-commit: checking Kotlin formatting (spotlessCheck)..."
    if ! (cd "$repo_root/apps/android" && ./gradlew -q spotlessCheck); then
        echo "pre-commit: Kotlin formatting check failed." >&2
        echo "  Fix it with: (cd apps/android && ./gradlew spotlessApply), then stage the result." >&2
        exit 1
    fi
fi

cpp_files=$(printf '%s\n' "$staged" | grep -E "$cpp_re" | grep -v '^core/third_party/')
if [ -n "$cpp_files" ]; then
    if ! command -v clang-format >/dev/null 2>&1; then
        echo "pre-commit: clang-format is required for staged C/C++ files but was not found on PATH." >&2
        echo "  Install LLVM/clang-format and retry." >&2
        exit 1
    fi
    echo "pre-commit: checking C/C++ formatting (clang-format)..."
    if ! printf '%s\n' "$cpp_files" | while IFS= read -r file; do
        clang-format --dry-run --Werror "$repo_root/$file" || exit 1
    done; then
        echo "pre-commit: C/C++ formatting check failed." >&2
        echo "  Fix it with: clang-format -i <file>, then stage the result." >&2
        exit 1
    fi
fi

exit 0
