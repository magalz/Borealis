{
  // markdownlint-cli2 settings. Rule configuration lives in .markdownlint.jsonc.
  // Inherited Moonlight files, the vendored moonlight-common-c and generated files are not linted.
  "ignores": [
    "apps/android/app/**",
    "apps/android/*.md",
    "core/third_party/moonlight-common-c/**",
    "CHANGELOG.md",
    "**/build/**"
  ]
}
