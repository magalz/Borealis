{
  // markdownlint-cli2 settings. Rule configuration lives in .markdownlint.jsonc.
  // Upstream (Moonlight subtree), forks and generated files are not linted.
  "ignores": [
    "apps/android/app/**",
    "apps/android/*.md",
    "apps/android/fastlane/**",
    "apps/android/.github/**",
    "apps/android/LuaScripts/**",
    "external/**",
    "CHANGELOG.md"
  ]
}
