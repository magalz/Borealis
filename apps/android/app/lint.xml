<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <issue id="InvalidPackage">
        <ignore path="**/bcpkix-jdk15on-*.jar"/>
    </issue>
    <!-- BOREALIS: path-based ignores instead of baseline entries, because baseline locations and messages differ between Windows and Linux. -->
    <issue id="TrustAllX509TrustManager">
        <ignore path="**/bcpkix-jdk18on-*.jar"/>
    </issue>
    <issue id="IconMissingDensityFolder">
        <ignore path="src/main/res"/>
    </issue>
    <!-- BOREALIS: the stream chrome replaced the connection spinner and dialogs (conn_establishing_msg, conn_starting, conn_error_title, conn_terminated_title) and PcView shows the host-aware hint of :borealis:host instead of this Sunshine text (pair_pairing_help); the upstream strings stay so syncs do not touch every locale. -->
    <issue id="UnusedResources">
        <ignore regexp="pair_pairing_help"/>
        <ignore regexp="conn_establishing_msg|conn_starting|conn_error_title|conn_terminated_title"/>
    </issue>
</lint>