<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Don't sync preferences because it often contains device-specific data -->
    <exclude domain="sharedpref" path="."/>
    <!-- The DataStore (borealis_settings) holds the Borealis settings stored there (the logging switches, the background, the five Appearance settings (font, accent colour, background intensity, card density and text spacing), the glass and the accessibility settings); it is settings too -->
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
