<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Don't sync preferences because it often contains device-specific data -->
    <exclude domain="sharedpref" path="."/>
    <!-- The DataStore (borealis_settings) holds the Borealis settings stored there (the logging switches and the background); it is settings too -->
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
