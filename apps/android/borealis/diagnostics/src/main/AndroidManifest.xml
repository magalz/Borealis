<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets ExportFlow ask whether any app can receive a zip. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/zip" />
        </intent>
    </queries>

    <application>
        <!-- Serves the diagnostic bundle to the app the user picks; only the bundle directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/borealis_diagnostics_paths" />
        </provider>
    </application>

</manifest>
