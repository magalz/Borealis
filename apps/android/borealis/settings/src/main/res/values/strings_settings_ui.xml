    <string name="settings_text_spacing_limited_summary">Drawn as %1$s at this text size, so that nothing is cut off.</string>
    <string name="settings_high_contrast_title">High contrast</string>
    <string name="settings_high_contrast_summary">Uses solid panels, brighter text, a dimmed background and the thicker outline.</string>
    <string name="settings_colour_vision_title">Colour-blind palette</string>
    <string name="settings_colour_vision_summary">Uses status colours that are easy to tell apart with red-green or blue-yellow colour blindness.</string>

