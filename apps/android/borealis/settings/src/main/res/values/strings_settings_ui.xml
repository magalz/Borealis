    <!-- Rows: Accessibility -->
    <string name="settings_reduce_motion_title">Reduce motion</string>
    <string name="settings_reduce_motion_summary">On removes animations; Off keeps them even when the device removes them. Follow system uses the device\'s animation setting.</string>
    <string name="settings_transparency_title">Transparency</string>
    <string name="settings_transparency_summary">%1$s and %2$s override %3$s and %4$s.</string>
    <string name="settings_thick_focus_title">Thicker focus outline</string>
    <string name="settings_thick_focus_summary">Draws a thicker, lighter outline around the focused item.</string>
    <string name="settings_text_size_title">Text size</string>
    <string name="settings_text_size_summary">Scales the text of Borealis on top of the system font size.</string>
