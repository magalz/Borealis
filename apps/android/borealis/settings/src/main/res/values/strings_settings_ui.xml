    <string name="settings_mouse_nav_buttons_summary">Can break right click on some devices.</string>
    <string name="settings_absolute_mouse_title">Remote desktop mouse mode</string>
    <string name="settings_absolute_mouse_summary">Mouse acceleration feels more natural on a remote desktop. Many games do not work with it.</string>
