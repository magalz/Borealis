    <string name="settings_deadzone_title">Deadzone</string>
    <string name="settings_deadzone_summary">Some games force a larger deadzone than this.</string>

    <!-- Rows: Gamepad -->
    <string name="settings_multi_controller_title">Multiple controllers</string>
    <string name="settings_multi_controller_summary">Turn off to make a gamepad always present.</string>
    <string name="settings_usb_driver_title">USB driver for Xbox controllers</string>
    <string name="settings_usb_driver_summary">A built-in driver for Xbox 360 and Xbox One controllers. Off also stops the USB attach dialog.</string>
    <string name="settings_usb_bind_all_title">Use the USB driver for all controllers</string>
    <string name="settings_usb_bind_all_summary">Use the driver even where the device supports a controller natively.</string>
    <string name="settings_flip_face_buttons_title">Flip face buttons</string>
    <string name="settings_flip_face_buttons_summary">Swap A and B, and X and Y, on gamepads and on-screen controls.</string>
    <string name="settings_touchpad_as_mouse_title">Touchpad as mouse</string>
    <string name="settings_touchpad_as_mouse_summary">The gamepad touchpad always moves the mouse of the PC.</string>
    <string name="settings_motion_sensors_title">Motion sensors</string>
    <string name="settings_motion_sensors_summary">Let the PC read the motion sensors of the gamepad.</string>
    <string name="settings_motion_fallback_title">Motion fallback</string>
    <string name="settings_motion_fallback_summary">Use the sensors of this device when the gamepad has none. The gamepad can appear as a PlayStation controller on the PC.</string>
    <string name="settings_vibrate_fallback_title">Vibrate fallback</string>
    <string name="settings_vibration_strength_title">Vibration strength</string>

