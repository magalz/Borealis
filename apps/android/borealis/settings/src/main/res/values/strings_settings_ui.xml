    <!-- Rows: Video -->
    <string name="settings_codec_title">Codec</string>
    <string name="settings_codec_summary">Newer codecs can lower the bandwidth. The PC or its GPU may not support the one you choose.</string>
    <string name="settings_hdr_title">HDR</string>
    <string name="settings_hdr_summary">Needs an HDR display and a PC GPU that encodes HEVC Main 10.</string>
