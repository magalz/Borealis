<?xml version="1.0" encoding="utf-8"?>
<!-- One element per entry. The diagnostics entries come from :borealis:diagnostics (ADR 0050). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/borealis_category_privacy">
        <CheckBoxPreference
            android:key="borealis_verbose_logging"
            android:title="@string/borealis_title_verbose_logging"
            android:summary="@string/borealis_summary_verbose_logging"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="borealis_mask_addresses"
            android:title="@string/borealis_title_mask_addresses"
            android:summary="@string/borealis_summary_mask_addresses"
            android:defaultValue="false" />
        <io.github.magalz.borealis.diagnostics.bundle.ExportDiagnosticsPreference
            android:key="borealis_export_diagnostics"
            android:title="@string/borealis_export_title"
            android:summary="@string/borealis_export_summary" />
        <io.github.magalz.borealis.diagnostics.audit.EraseAuditPreference
            android:key="borealis_erase_audit" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/borealis_category_about">
        <Preference
            android:key="borealis_about_version"
            android:title="@string/borealis_title_version"
            android:selectable="false" />
        <io.github.magalz.borealis.settings.LinkPreference
            android:key="borealis_about_source_code"
            android:title="@string/borealis_title_source_code"
            url="https://github.com/magalz/Borealis" />
        <Preference
            android:key="borealis_about_license"
            android:title="@string/borealis_title_license"
            android:summary="@string/borealis_summary_license"
            android:selectable="false" />
        <io.github.magalz.borealis.settings.LicensesPreference
            android:key="borealis_about_licenses"
            android:title="@string/borealis_title_open_source_licenses"
            android:summary="@string/borealis_summary_open_source_licenses" />
        <io.github.magalz.borealis.settings.LinkPreference
            android:key="borealis_about_privacy_policy"
            android:title="@string/borealis_title_privacy_policy"
            url="https://github.com/magalz/Borealis/blob/main/PRIVACY.md" />
    </PreferenceCategory>

</PreferenceScreen>
