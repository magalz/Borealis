<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One line, the first time, saying how to open the menu on this device. -->
    <string name="stream_hint_phone">Pull the handle down or press Back for the menu</string>
    <string name="stream_hint_handheld">Hold Select + Start for the menu</string>
    <string name="stream_hint_tv">Press Back for the menu</string>
    <!-- With a keyboard or a mouse and no pad: every way that opens the menu. Back and Forward of the
         mouse pressed together open it with "Mouse back and forward buttons" on or off, and Android
         cannot tell a pulse mouse (it cannot hold Back) before its first side-button press.
         stream_hint_keyboard holds the text for the setting off. stream_hint_keyboard_mouse holds
         the text for the setting on, the only case where holding Back opens the menu too. -->
    <string name="stream_hint_keyboard">Press Ctrl+Alt+Shift+M or press the mouse Back and Forward buttons together for the menu</string>
    <string name="stream_hint_keyboard_mouse">Press Ctrl+Alt+Shift+M, hold the mouse Back button, or press Back and Forward together for the menu</string>
</resources>
